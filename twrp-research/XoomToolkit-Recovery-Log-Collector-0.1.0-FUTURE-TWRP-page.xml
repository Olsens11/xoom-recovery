<?xml version='1.0' encoding='utf-8'?>
<future_toolkit_pages>
  <page name="xoom_toolkit_details_log_collector">
    <template name="page" />
    <button>
      <placement x="1672" y="34" w="156" h="69" />
      <fill color="#1c75a8" />
      <font resource="font_s" color="#ffffff" />
      <text>Help</text>
      <action function="page">xoom_toolkit_details_log_collector_help</action>
    </button>
    <text>
      <placement x="81" y="187" />
      <font resource="font_l" color="%text_color%" />
      <text>Recovery Log Collector</text>
    </text>
    <text>
      <placement x="81" y="272" />
      <font resource="font_m" color="%accent_color%" />
      <text>Read-only system snapshot and safe export</text>
    </text>
    <text>
      <placement x="81" y="365" />
      <font resource="font_m" color="%text_color%" />
      <text>Status: %xt_log_collector_status%</text>
    </text>
    <text>
      <placement x="81" y="435" />
      <font resource="font_m" color="%text_color%" />
      <text>Collect creates a sanitized summary in recovery RAM.</text>
    </text>
    <text>
      <placement x="81" y="493" />
      <font resource="font_m" color="%text_color%" />
      <text>Export copies the latest report to SD on request.</text>
    </text>
    <text>
      <placement x="81" y="558" />
      <font resource="font_s" color="%text_color%" />
      <text>No raw Wi-Fi profiles, tokens, command lines, or full logs are copied.</text>
    </text>
    <button>
      <placement x="81" y="755" w="410" h="72" />
      <fill color="#216d99" />
      <font resource="font_m" color="#ffffff" />
      <text>Collect Report</text>
      <action function="xoomtoolkitexec">start:recovery-log-collector</action>
    </button>
    <button>
      <placement x="542" y="755" w="420" h="72" />
      <fill color="#264e7c" />
      <font resource="font_m" color="#ffffff" />
      <text>Export to SD</text>
      <action function="xoomtoolkitexec">export:recovery-log-collector</action>
    </button>
    <button>
      <placement x="1002" y="755" w="420" h="72" />
      <fill color="#264e7c" />
      <font resource="font_m" color="#ffffff" />
      <text>Refresh Status</text>
      <action function="xoomtoolkit">log-collector-refresh</action>
    </button>
    <button>
      <placement x="1440" y="1050" w="370" h="68" />
      <fill color="#264e7c" />
      <font resource="font_m" color="#ffffff" />
      <text>Back to Toolkit</text>
      <action function="page">xoom_toolkit</action>
    </button>
    <action>
      <touch key="back" />
      <action function="page">xoom_toolkit</action>
    </action>
  </page>
  <page name="xoom_toolkit_details_log_collector_help">
    <template name="page" />
    <text>
      <placement x="81" y="192" />
      <font resource="font_l" color="%text_color%" />
      <text>Recovery Log Collector Help</text>
    </text>
    <text>
      <placement x="82" y="322" />
      <font resource="font_s" color="%accent_color%" />
      <text>PURPOSE</text>
    </text>
    <text>
      <placement x="578" y="322" />
      <font resource="font_s" color="#d0dce9" />
      <text>Creates a small diagnostic report for recovery problems.</text>
    </text>
    <text>
      <placement x="82" y="382" />
      <font resource="font_s" color="%accent_color%" />
      <text>REQUIRES</text>
    </text>
    <text>
      <placement x="578" y="382" />
      <font resource="font_s" color="#d0dce9" />
      <text>The package must be loaded; internet access is not needed.</text>
    </text>
    <text>
      <placement x="82" y="442" />
      <font resource="font_s" color="%accent_color%" />
      <text>COLLECT</text>
    </text>
    <text>
      <placement x="578" y="442" />
      <font resource="font_s" color="#d0dce9" />
      <text>Collect Report builds a sanitized snapshot in recovery RAM.</text>
    </text>
    <text>
      <placement x="578" y="502" />
      <font resource="font_s" color="#d0dce9" />
      <text>It includes known states, transitions and warning/error counts.</text>
    </text>
    <text>
      <placement x="82" y="562" />
      <font resource="font_s" color="%accent_color%" />
      <text>EXPORT</text>
    </text>
    <text>
      <placement x="578" y="562" />
      <font resource="font_s" color="#d0dce9" />
      <text>Export to SD saves the latest report only when requested.</text>
    </text>
    <text>
      <placement x="578" y="622" />
      <font resource="font_s" color="#d0dce9" />
      <text>A verified, writable microSD card is required for exporting.</text>
    </text>
    <text>
      <placement x="82" y="682" />
      <font resource="font_s" color="%accent_color%" />
      <text>STARTUP</text>
    </text>
    <text>
      <placement x="578" y="682" />
      <font resource="font_s" color="#d0dce9" />
      <text>Autoload loads the module; Autorun is optional, not required.</text>
    </text>
    <text>
      <placement x="578" y="742" />
      <font resource="font_s" color="#d0dce9" />
      <text>Early boot collection may miss later problems; collect again.</text>
    </text>
    <text>
      <placement x="82" y="802" />
      <font resource="font_s" color="%accent_color%" />
      <text>PRIVACY</text>
    </text>
    <text>
      <placement x="578" y="802" />
      <font resource="font_s" color="#d0dce9" />
      <text>The default report excludes raw Wi-Fi profiles and log lines.</text>
    </text>
    <text>
      <placement x="578" y="862" />
      <font resource="font_s" color="#d0dce9" />
      <text>Review the report before sending it to someone else.</text>
    </text>
    <text>
      <placement x="82" y="922" />
      <font resource="font_s" color="%accent_color%" />
      <text>IF IT FAILS</text>
    </text>
    <text>
      <placement x="578" y="922" />
      <font resource="font_s" color="#d0dce9" />
      <text>Missing log sources are reported as unavailable.</text>
    </text>
    <button>
      <placement x="1455" y="1053" w="375" h="69" />
      <fill color="#264e7c" />
      <font resource="font_s" color="#ffffff" />
      <text>Back to Package</text>
      <action function="page">xoom_toolkit_details_log_collector</action>
    </button>
    <action>
      <touch key="back" />
      <action function="page">xoom_toolkit_details_log_collector</action>
    </action>
  </page>
</future_toolkit_pages>